# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Spotify
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override rekordbox DB path (leave blank for auto-detect)
REKORDBOX_DB_PATH=

# Optional: rekordbox XML export path (fallback mode)
REKORDBOX_XML_PATH=

# SoundCloud — used to verify tracks Spotify can't identify (edits, bootlegs etc.)
# The script can auto-fetch this from soundcloud.com's JS bundles, but if that
# breaks set it manually:
#   1. Open soundcloud.com → DevTools → Network
#   2. Search for any track
#   3. Find a request to api-v2.soundcloud.com and copy the client_id param
SOUNDCLOUD_CLIENT_ID=
