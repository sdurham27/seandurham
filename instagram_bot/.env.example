# Instagram Graph API credentials
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to source control.

# Your Instagram Business/Creator account numeric User ID
IG_USER_ID=your_instagram_user_id_here

# Long-lived Page Access Token with scopes:
#   instagram_basic, instagram_content_publish, pages_read_engagement
IG_ACCESS_TOKEN=your_long_lived_access_token_here

# Optional: publicly reachable URL of the generated image.
# Set this if your CI/CD pipeline uploads the image to a CDN/S3 before posting.
# If not set, the script will attempt a direct file upload.
# IMAGE_PUBLIC_URL=https://example.com/space_fact.jpg

# Set to "true" to generate the image without posting to Instagram (for testing)
# DRY_RUN=true
